# PayCore local development configuration
# Copy to .env and adjust. NEVER commit .env - it is in .gitignore.

APP_ENV=local
APP_PORT=8000
LOG_LEVEL=debug

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=paycore
POSTGRES_USER=paycore
POSTGRES_PASSWORD=changeme_local_only

REDIS_URL=redis://localhost:6379/0

RISK_ENGINE_THRESHOLD=70
RISK_ENGINE_TIMEOUT_MS=250
